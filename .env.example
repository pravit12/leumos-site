# Public site URL — used for canonical URLs, sitemap, robots, JSON-LD, OG/Twitter
# Set to the production origin in production; preview/dev can leave default.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Email service provider (waitlist capture) ===
# Resend is the chosen ESP — handles transactional confirmation emails AND the
# audience list. See README "ESP / storage" section for the rationale.
# RESEND_API_KEY=re_xxx
# Friendly From line for the waitlist confirmation email.
# RESEND_FROM_EMAIL="Leumos AI <hello@leumos.ai>"
# Resend Audience to sync waitlist contacts into.
# RESEND_AUDIENCE_ID=

# === Waitlist storage (Vercel KV / Upstash Redis) ===
# Required in production. Locally and in CI, an in-memory fallback is used so
# the form still works for testing — sign-ups won't persist across restarts.
# When Vercel KV is provisioned the Vercel integration injects KV_REST_API_*.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (or, if you wire Upstash directly, the same values can be supplied as)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# === Analytics (privacy-first) ===
# Plausible: set the data domain matching your production hostname.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=leumos.ai
# Microsoft Clarity (heatmaps): the project id from Clarity dashboard.
# NEXT_PUBLIC_CLARITY_PROJECT_ID=

# === Google Search Console ===
# Verification token; rendered as <meta name="google-site-verification" />.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# === Vercel-injected, do not set manually ===
# VERCEL_URL — preview/prod hostname provided by Vercel at build/runtime.
# VERCEL_ENV — "production" | "preview" | "development".
