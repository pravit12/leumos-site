# Public site URL — used for canonical URLs, sitemap, robots, JSON-LD, OG/Twitter
# Set to the production origin in production; preview/dev can leave default.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Email service provider (waitlist capture) ===
# Pick one (Resend default). Leave the others blank.
# RESEND_API_KEY=re_xxx
# RESEND_AUDIENCE_ID=
# LOOPS_API_KEY=

# === Analytics (privacy-first, Plausible) ===
# Plausible: set the data domain matching your production hostname.
# Only loads when VERCEL_ENV === "production" (preview/dev stay clean).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=leumos.ai

# === Heatmaps + session recording (Microsoft Clarity) ===
# Project id from clarity.microsoft.com. Loads in production only.
# NEXT_PUBLIC_CLARITY_PROJECT_ID=

# === Search-console verification (HTML-meta method) ===
# Google Search Console: rendered as <meta name="google-site-verification" />.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: rendered as <meta name="msvalidate.01" />.
# Optional — Bing's "import from GSC" path means this is only needed if
# we verify Bing standalone instead of importing the GSC ownership.
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# === Vercel-injected, do not set manually ===
# VERCEL_URL — preview/prod hostname provided by Vercel at build/runtime.
# VERCEL_ENV — "production" | "preview" | "development".
